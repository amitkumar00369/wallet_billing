# All values are optional; the defaults below are for local development only.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Fixed price of one consultation minute, in rupees. Copied onto a session when it starts.
SESSION_RATE_PER_MINUTE=50.00

# Shared secret the mock payment provider sends in the X-Callback-Secret header.
RECHARGE_CALLBACK_SECRET=dev-callback-secret
